    "questions": [
      {
        "maxLength": 4000,
        "label": "何をしたいですか？",
        "required": true,
        "id": "task",
        "placeholder": "ダウンロードしたファイルを開きたい",
        "type": "textarea"
      },
      {
        "label": "どこで困っていますか？",
        "required": true,
        "type": "singleSelect",
        "id": "issue",
        "options": [
          {
            "value": "場所が分からない",
            "label": "どこにあるか分からない"
          },
          {
            "value": "操作が分からない",
            "label": "操作が分からない"
          },
          {
            "value": "unknown",
            "label": "分からない"
          }
        ]
      },
      {
        "label": "画面に何が表示されていますか？",
        "type": "textarea",
        "id": "details",
        "visibleWhen": {
          "questionId": "issue",
          "operator": "equals",
          "value": "場所が分からない"
        }
      }
    ],
    "category": "PC操作",
    "origin": "bundled",
    "description": "クリックする場所から、一度に少しずつ案内してもらいます"
  },
